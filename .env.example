# SoundReels Environment Variables Example

# Gemini API Key (For Korean -> English Prompt Expansion)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash-lite

# Freesound API (Optional for P2)
FREESOUND_CLIENT_ID=
FREESOUND_API_KEY=

# Local Server Settings
HOST=127.0.0.1
PORT=8000
